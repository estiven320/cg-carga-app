# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://cgcarga:cgcarga@localhost:5432/cgcarga?schema=public"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="12h"
CORS_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Nominatim (OpenStreetMap) - costo $0
# Politica de uso: max 1 req/s y User-Agent identificable obligatorio.
# En produccion se recomienda self-host: NOMINATIM_BASE_URL=http://nominatim:8080
# ---------------------------------------------------------------------------
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="CG-CARGA-TMS/0.1 (contacto@cgcarga.co)"
NOMINATIM_EMAIL="contacto@cgcarga.co"
NOMINATIM_MIN_INTERVAL_MS=1100
NOMINATIM_TIMEOUT_MS=10000
NOMINATIM_MAX_RETRIES=3
NOMINATIM_COUNTRY_CODES="co"
NOMINATIM_COUNTRY_SUFFIX="Colombia"
GEOCODE_CACHE_TTL_DAYS=180

# ---------------------------------------------------------------------------
# MinIO (S3 self-hosted) para fotos POD
# ---------------------------------------------------------------------------
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="cgcarga"
MINIO_SECRET_KEY="cgcarga-secret"
MINIO_BUCKET="pod"
MINIO_REGION="us-east-1"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_PRESIGN_EXPIRY_SECONDS=3600

# ---------------------------------------------------------------------------
# WhatsApp (Evolution API por defecto | Baileys embebido como alternativa)
# WHATSAPP_PROVIDER: evolution | baileys | disabled
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER="evolution"
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="cambiar-en-produccion"
EVOLUTION_INSTANCE="cgcarga"
WHATSAPP_DEFAULT_COUNTRY_CODE="57"
BAILEYS_SESSION_PATH="./.baileys-session"

# ---------------------------------------------------------------------------
# Importacion de despacho
# ---------------------------------------------------------------------------
IMPORT_DEFAULT_SHEET="PROGRAMACION 3 DE SEPTIEMBRE"
IMPORT_MAX_FILE_MB=25

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; Colaboradores de OpenStreetMap"
NEXT_PUBLIC_MAP_CENTER_LAT=4.6482
NEXT_PUBLIC_MAP_CENTER_LNG=-74.0776
NEXT_PUBLIC_MAP_ZOOM=11
